@page "/"
@implements IDisposable
@inject TaskService Tasks
@inject PreferenceService Preferences

<AppHeader />

<main class="page-shell">
    <div class="main-layout">
        <TaskSheet />
        <aside class="utility-column" aria-label="Planner tools">
            <CalendarCard />
            <QuickAddCard />
            <CategoriesCard />
        </aside>
    </div>
</main>

<AppFooter />

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Tasks.OnChange += HandleChange;
            await Preferences.LoadAsync(Tasks);
        }
    }

    private void HandleChange() => _ = Preferences.SaveAsync(Tasks);

    public void Dispose() => Tasks.OnChange -= HandleChange;
}