<button type="button" class="delete-task-button"
        aria-label="Delete task" title="Delete task"
        @onclick="OnDelete">
    <svg class="delete-task-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M4 8h16M10 8V5h4v3M7 8l1 12h8l1-12M10 11v5M14 11v5"
              fill="none" stroke="var(--color-shadow-grey)" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round" />
    </svg>
</button>

@code {
    [Parameter] public Guid TaskId { get; set; }

    [Parameter] public EventCallback OnDelete { get; set; }
}