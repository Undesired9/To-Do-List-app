@implements IDisposable
@inject TaskService Tasks

<section id="calendar-card" class="paper-card" aria-labelledby="calendar-heading">
    <div class="card-header">
        <h2 id="calendar-heading" class="card-title">@MonthLabel</h2>
        <div class="calendar-nav">
            <button type="button" class="icon-button" aria-label="Previous month"
                    @onclick="() => Tasks.NavigateMonth(-1)">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M15 5l-7 7 7 7" fill="none" stroke="var(--color-shadow-grey)"
                          stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>
            <button type="button" class="icon-button" aria-label="Next month"
                    @onclick="() => Tasks.NavigateMonth(1)">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M9 5l7 7-7 7" fill="none" stroke="var(--color-shadow-grey)"
                          stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>
        </div>
    </div>

    <div class="calendar-grid">
        @foreach (var name in WeekdayNames)
        {
            <span class="calendar-weekday" aria-hidden="true">@name</span>
        }
        @foreach (var cell in _cells)
        {
            if (cell is null)
            {
                <span class="calendar-blank" aria-hidden="true"></span>
            }
            else
            {
                var date = cell.Value;
                var isSelected = date == Tasks.SelectedDate;
                var hasTasks = _taskDates.Contains(date);
                <button type="button"
                        class="calendar-day @(isSelected ? "is-selected" : null) @(hasTasks ? "has-tasks" : null)"
                        aria-label="@($"Select {date:MMMM d}")"
                        aria-current="@(isSelected ? "date" : null)"
                        @onclick="() => Tasks.SelectDate(date)">
                    <span class="day-number">@date.Day</span>
                    @if (hasTasks)
                    {
                        <span class="calendar-task-mark" aria-hidden="true"></span>
                    }
                </button>
            }
        }
    </div>
</section>

@code {
    private static readonly string[] WeekdayNames = { "S", "M", "T", "W", "T", "F", "S" };

    private HashSet<DateOnly> _taskDates = new();

    private string MonthLabel => Tasks.VisibleMonth.ToString("MMMM yyyy").ToUpperInvariant();

    private IReadOnlyList<DateOnly?> _cells
    {
        get
        {
            var first = Tasks.VisibleMonth;
            var days = DateTime.DaysInMonth(first.Year, first.Month);
            var lead = (int)first.DayOfWeek;
            var cells = new List<DateOnly?>(lead + days);
            for (var i = 0; i < lead; i++)
            {
                cells.Add(null);
            }
            for (var day = 1; day <= days; day++)
            {
                cells.Add(new DateOnly(first.Year, first.Month, day));
            }
            return cells;
        }
    }

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Tasks.OnChange += HandleChange;
        }
    }

    private void HandleChange() => _ = RefreshAsync();

    private async Task RefreshAsync()
    {
        _taskDates = (await Tasks.GetTaskDatesInVisibleMonthAsync()).ToHashSet();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Tasks.OnChange -= HandleChange;
}