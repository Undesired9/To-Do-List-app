@implements IDisposable
@inject TaskService Tasks

<section class="task-sheet" aria-labelledby="sheet-heading">
    <h1 id="sheet-heading" class="sheet-heading">TO-DO TODAY: @MonthName @Tasks.SelectedDate.Day</h1>
    <p class="sheet-subheading">@_total tasks &bull; @_completed completed</p>

    @if (_items.Count == 0)
    {
        <p class="sheet-empty">Nothing on your doodle pad yet. Add a task!</p>
    }
    else
    {
        <ul class="sheet-list">
            @foreach (var item in _items)
            {
                <TaskRow @key="item.Id"
                         Task="item"
                         OnToggle="() => ToggleAsync(item.Id)"
                         OnDelete="() => DeleteAsync(item.Id)"
                         OnDescriptionSaved="SaveDescriptionAsync" />
            }
        </ul>
    }

    <p class="sheet-note" aria-hidden="true">&#x270e; doodle it. do it. done.</p>
</section>

@code {
    private IReadOnlyList<TaskItem> _items = Array.Empty<TaskItem>();
    private int _total;
    private int _completed;

    private string MonthName => Tasks.SelectedDate.ToString("MMMM").ToUpperInvariant();

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    // Subscribe on the interactive circuit only, avoiding a leak from the prerender pass.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Tasks.OnChange += HandleChange;
        }
    }

    private void HandleChange() => _ = RefreshAsync();

    private async Task RefreshAsync()
    {
        _items = await Tasks.GetVisibleTasksAsync();
        _total = await Tasks.GetTotalCountAsync();
        _completed = await Tasks.GetCompletedCountAsync();
        await InvokeAsync(StateHasChanged);
    }

    private Task ToggleAsync(Guid id) => Tasks.ToggleTaskAsync(id);

    private Task DeleteAsync(Guid id) => Tasks.DeleteTaskAsync(id);

    private Task SaveDescriptionAsync((Guid TaskId, string? Description) note) =>
        Tasks.SetDescriptionAsync(note.TaskId, note.Description);

    public void Dispose() => Tasks.OnChange -= HandleChange;
}